# 复制为部署环境的 EnvironmentFile；不要提交真实密钥。
DATABASE_URL=sqlite:////absolute/path/to/server/data/agent.db
FIRMWARE_DIR=/absolute/path/to/server/data/firmware
DIALOGUE_PROVIDER=echo
# cloud = SiliconFlow ASR/TTS + OpenAI 兼容 LLM
# xiaoling = SiliconFlow ASR/TTS + 按账号隔离的小綾对话
XIAOLING_BASE_URL=http://127.0.0.1:8010
# 仅服务端使用的面板管理员凭据；普通用户的 public peer 由服务端自动创建。
XIAOLING_ADMIN_TOKEN=
XIAOLING_PUBLIC_DAILY_TOKENS=20000
XIAOLING_TO=小綾
# 供小綾插件等内部服务调用 /api/v1/voice/* 的静态令牌（留空则接口禁用）
VOICE_SERVICE_TOKEN=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
PAIRING_TOKEN_MINUTES=10
MAX_AUDIO_BYTES=4194304
AUDIO_FRAME_BYTES=640

SILICONFLOW_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=anna

# 未填写 OPENAI_API_KEY/DEEPSEEK_API_KEY 时，自动复用 SILICONFLOW_API_KEY 与其 OpenAI 兼容接口。
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_SYSTEM=你是 ESP32-S3 上的语音助手，回答简短、自然。
LLM_HISTORY_MESSAGES=12
