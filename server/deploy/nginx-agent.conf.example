# 公网设备连接：wss://example.com/agent/ws/v1/device?token=<device_token>
# 设备 REST（含 OTA manifest/download/result）同样使用 ?token=，不依赖 Authorization。
location = /agent/ws/v1/device {
    access_log off;
    error_log /var/log/nginx/agent-ws-error.log crit;

    proxy_pass http://127.0.0.1:8781/ws/v1/device;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# /agent/api/v1/... -> 127.0.0.1:8781/api/v1/...
location /agent/ {
    proxy_pass http://127.0.0.1:8781/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Prefix /agent;
    client_max_body_size 64m;
    proxy_read_timeout 120s;
}
